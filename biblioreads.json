        {
            "id": "kca://review:goodreads/amzn1.gr.review:goodreads.v1.qOdgrbVKU-XMQR5DSbHfDQ",
            "reviewer": {
                "id": 16979552,
                "name": "Sarah Garner",
                "url": "/user/show/16979552-sarah-garner",
                "avatar": "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1408284741i/16979552._UX200_CR0,53,200,200_.jpg",
                "isAuthor": false,
                "reviewCount": 84,
                "followerCount": 18
            },
            "rating": 2,
            "text": "I struggled with this book and I couldn't finish it, although it was a great idea, I didn't love this book.",
            "createdAt": "Sat Sep 20 2014",
            "updatedAt": "Thu Aug 20 2020",
            "spoiler": false,
            "likeCount": 1,
            "commentCount": 0,
            "recommendFor": null,
