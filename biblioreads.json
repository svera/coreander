        {
            "id": "kca://review:goodreads/amzn1.gr.review:goodreads.v1.be94OXB9ezWIlFZvdGMKvA",
            "reviewer": {
                "id": 2478293,
                "name": "Zeek",
                "url": "/user/show/2478293-zeek",
                "avatar": "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1339154824i/2478293.jpg",
